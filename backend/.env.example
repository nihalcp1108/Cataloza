# ============================================================
# SERVER ENVIRONMENT CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=5000

# ============================================================
# DATABASE (MongoDB Atlas or Local MongoDB)
# ============================================================
MONGODB_URI=mongodb://localhost:27017/wholesale_catalogue

# ============================================================
# CORS & FRONTEND APPS
# ============================================================
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# COOKIES
# ============================================================
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============================================================
# CLOUDINARY (Media Uploads)
# Leave empty for local data-URI / fallback upload mode
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# SMTP EMAIL DELIVERY (Super Admin 2FA OTP & Invitations)
# ============================================================
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587 (or 465 for SSL)
# SMTP_SECURE=false (true if port 465)
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password (16-char Google App Password)
# EMAIL_FROM="WholesaleFlow Security <no-reply@wholesaleflow.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cateloge OTP <your_email@gmail.com>"

# ============================================================
# SUPER ADMIN BOOTSTRAP CREDENTIALS
# Used by: npm run bootstrap:admin
# ============================================================
SUPER_ADMIN_EMAIL=cpnihal35@gmail.com
SUPER_ADMIN_INITIAL_PASSWORD=YourSecureInitialPasswordHere123!
SUPER_ADMIN_NAME=Platform Super Administrator
SUPER_ADMIN_BOOTSTRAP_SECRET=super_bootstrap_secure_token_2026
