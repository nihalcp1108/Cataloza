# ============================================================
# SERVER ENVIRONMENT CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=5001

# ============================================================
# DATABASE (MongoDB Atlas or Local MongoDB)
# ============================================================
MONGODB_URI=mongodb://localhost:27017/wholesale_catalogue

# ============================================================
# CORS & FRONTEND APPS
# ============================================================
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:5001/api/v1

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# COOKIES
# ============================================================
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============================================================
# CLOUDINARY (Media Uploads)
# Leave empty for local data-URI / fallback upload mode
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# RESEND EMAIL DELIVERY (HTTPS API)
# Used on Railway Hobby Plan (Replaces SMTP to prevent port 587 timeout)
# ============================================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# For testing: "Cataloza <onboarding@resend.dev>" (delivers to your Resend account email)
# For production: "Cataloza <notifications@yourverifieddomain.com>"
RESEND_FROM_EMAIL="Cataloza <onboarding@resend.dev>"

# ============================================================
# SUPER ADMIN BOOTSTRAP CREDENTIALS
# Used by: npm run bootstrap:admin
# ============================================================
SUPER_ADMIN_EMAIL=cpnihal35@gmail.com
SUPER_ADMIN_INITIAL_PASSWORD=YourSecureInitialPasswordHere123!
SUPER_ADMIN_NAME=Platform Super Administrator
SUPER_ADMIN_BOOTSTRAP_SECRET=super_bootstrap_secure_token_2026
