{
  "name": "wholesale-catalogue-backend",
  "version": "1.0.0",
  "description": "Multi-Tenant Wholesale Catalogue Backend API",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "bootstrap:admin": "tsx scripts/bootstrapAdmin.ts",
    "reset:admin": "tsx scripts/bootstrapAdmin.ts --reset-password",
